#!/bin/bash
set -e

echo "Running pre-commit hook: building and minimizing Versi Riflessi..."

python3 hooks/minimize.py || {
    echo "Errore durante l'esecuzione di minimize.py. Commit annullato."
    exit 1
}

# Aggiunge i file generati per il deploy allo staging Git
git add index.html service-worker.js manifest.json

echo "✓ Pre-commit completato con successo!"